{"utc": "2026-11-04T17:18:51.796123+00:00", "actor": "worker-03", "kind": "tool_result", "value": {"files": {"module.py": {"sha256": "08f0cce7d6b7b26b04f54ac4548bf4c36563b032217bccf480c18e694f096152", "content": "def _kind(v):\n    if isinstance(v, dict):\n        return 'object'\n    if isinstance(v, list):\n        return 'list'\n    if isinstance(v, str):\n        return 'string'\n    if isinstance(v, bool):\n        return 'boolean'\n    if isinstance(v, (int, float)):\n        return 'number'\n    if v is None:\n        return 'null'\n    raise ValueError('unsupported JSON value type')\n\n\ndef _clone(v):\n    if isinstance(v, dict):\n        return {k: _clone(x) for k, x in v.items()}\n    if isinstance(v, list):\n        return [_clone(x) for x in v]\n    return v\n\n\ndef _merge(base, patch):\n    out = _clone(base)\n    for k, pv in patch.items():\n        if pv is None:\n            out.pop(k, None)\n            continue\n        if k not in out:\n            out[k] = _clone(pv)\n            continue\n        bv = out[k]\n        bk = _kind(bv)\n        pk = _kind(pv)\n        if bk == 'object' and pk == 'object':\n            out[k] = _merge(bv, pv)\n        elif bk == 'list' and pk == 'list':\n            out[k] = _clone(pv)\n        elif bk != pk:\n            raise ValueError('type mismatch for key %r' % (k,))\n        else:\n            out[k] = pv\n    return out\n\n\ndef solve(data):\n    if not isinstance(data, dict):\n        raise ValueError('data must be a dict')\n    if 'base' not in data or 'patch' not in data:\n        raise ValueError('data must contain base and patch')\n    base = data['base']\n    patch = data['patch']\n    if not isinstance(base, dict) or not isinstance(patch, dict):\n        raise ValueError('base and patch must be JSON objects')\n    return _merge(base, patch)\n"}, "test_cases.json": {"sha256": "5fc11ba9f64d05f507befe34cebca5c88537833830209147f7835cca778f0aa1", "content": "[\n  {\n    \"input\": {\n      \"base\": {\n        \"a\": {\n          \"x\": 1\n        }\n      },\n      \"patch\": {\n        \"a\": {\n          \"y\": 2\n        }\n      }\n    },\n    \"name\": \"nested_object_merge\",\n    \"output\": {\n      \"a\": {\n        \"x\": 1,\n        \"y\": 2\n      }\n    }\n  },\n  {\n    \"input\": {\n      \"base\": {\n        \"a\": 1,\n        \"b\": 2\n      },\n      \"patch\": {\n        \"a\": null,\n        \"c\": null\n      }\n    },\n    \"name\": \"null_removes_key_and_absent_noop\",\n    \"output\": {\n      \"b\": 2\n    }\n  },\n  {\n    \"input\": {\n      \"base\": {\n        \"l\": [\n          1,\n          2\n        ]\n      },\n      \"patch\": {\n        \"l\": [\n          3\n        ]\n      }\n    },\n    \"name\": \"list_replaced_not_concatenated\",\n    \"output\": {\n      \"l\": [\n        3\n      ]\n    }\n  },\n  {\n    \"error\": \"ValueError\",\n    \"input\": {\n      \"base\": {\n        \"f\": true\n      },\n      \"patch\": {\n        \"f\": 1\n      }\n    },\n    \"name\": \"boolean_number_type_mismatch\"\n  },\n  {\n    \"error\": \"ValueError\",\n    \"input\": {\n      \"base\": [\n        1\n      ],\n      \"patch\": {}\n    },\n    \"name\": \"non_object_base_rejected\"\n  },\n  {\n    \"input\": {\n      \"base\": {\n        \"a\": 2,\n        \"z\": 1\n      },\n      \"patch\": {\n        \"a\": 5,\n        \"b\": 4,\n        \"m\": 3\n      }\n    },\n    \"name\": \"key_order_base_then_patch_only\",\n    \"output\": {\n      \"a\": 5,\n      \"b\": 4,\n      \"m\": 3,\n      \"z\": 1\n    }\n  }\n]\n"}}}}

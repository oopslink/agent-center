}} project\",usedBy_other:\"used by {{count}} projects\",viewRemote:\"View remote\",hideRemote:\"Hide remote\",edit:\"Edit\",delete:\"Delete\"},remote:{heading:\"Remote —\",liveBadge:\"live · remote\",tabs:{commits:\"Commits\",branches:\"Branches\"},branchLabel:\"Branch\",noCommits:\"No commits.\",noBranches:\"No branches.\",defaultBranch:\"default\",footer:\"Live from the remote (go-github; falls back to git ls-remote). Never cloned.\",unavailable:\"Remote viewing isn't available right now.\"},commits:{dayHeader:\"Commits on {{day}}\",unknownDate:\"unknown date\"},commit:{hideDescriptionAria:\"Hide commit description\",showDescriptionAria:\"Show commit description\",hideDescription:\"Hide description\",showDescription:\"Show description\",unknownAuthor:\"unknown\",committed:\"committed {{time}}\",browseAria:\"Browse the repository at {{short}}\",browseTitle:\"Browse the repository at this point\",copyAria:\"Copy the full commit SHA\",copied:\"Copied\",copyTitle:\"Copy full SHA\"},form:{editTitle:\"Edit repository\",addTitle:\"Add repository\",close:\"Close\",label:\"Label\",labelPlaceholder:\"agent-center\",provider:\"Provider\",providerGithub:\"GitHub\",providerGit:\"Git (generic)\",description:\"Description\",descriptionHint:\"One line so an agent understands the repo without checking it out.\",descriptionPlaceholder:\"What this repo is for\",url:\"Clone URL\",urlPlaceholder:\"git@github.com:org/repo.git\",defaultBranch:\"Default branch\",defaultBranchPlaceholder:\"main\",credential:\"Read credential\",credentialHintEdit:\"Leave blank to keep the stored credential.\",credentialHintCreate:\"Stored encrypted, never shown again.\",credentialPlaceholderStored:\"•••••• (stored)\",credentialPlaceholder:\"fine-grained token\",credentialHelp:\"Private repos need a read-only credential. For GitHub, create a <tokenLink>fine-grained token</tokenLink> scoped to this repository with <contents>Contents: Read-only</contents> (add <prs>Pull requests: Read</prs> to view PRs). A G
reator\"},rail:{nodesDone:\"nodes done\"},goal:{close:\"Close goal\",title:\"Plan goal\",heading:\"Goal\",empty:\"No goal set.\",showLess:\"Show less\",showMore:\"Show more\"},upNext:{title:\"Up next\",empty:\"No nodes queued.\",more:\"+{{count}} more — view DAG\"},deleteModal:{title:\"Delete this plan?\",body:\"This unloads all this plan's tasks back to the Backlog, permanently deletes the plan's conversation, and deletes the plan. This cannot be undone.\",confirm:\"Delete plan\",pending:\"Deleting…\"},archiveModal:{title:\"Archive this plan?\",body:\"This hides the terminal plan from active views while preserving its done/discarded lifecycle truth and execution history.\",confirm:\"Archive plan\",pending:\"Archiving…\"},discardModal:{title:\"Discard this plan?\",body:\"This permanently abandons the plan and discards its unfinished tasks. Completed tasks and stage history remain immutable.\",confirm:\"Discard plan\",pending:\"Discarding…\"},editModal:{aria:\"Edit plan\",title:\"Edit Plan\",name:\"Name\",goal:\"Goal\",targetDate:\"Target date\",save:\"Save changes\",saving:\"Saving…\",errorArchived:\"This plan is archived and can no longer be edited.\",errorPending:\"The target date can only be changed while the plan is pending.\",errorGeneric:\"Couldn't save your changes. Please try again.\"},evolutionModal:{aria:\"Plan evolution\",title:\"Commit plan evolution\",baseVersion:\"Base version {{version}}\",parentGeneration:\"Parent generation {{id}}\",liveStatus:\"{{status}} topology\",reason:\"Reason\",evidence:\"Evidence\",idempotency:\"Idempotency key\",diff:\"PlanGenerationDiff JSON\",diffHint:\"Provide complete node_decisions, tasks, and edges arrays. New task refs can be used by edge from/to fields.\",commit:\"Commit evolution\",committing:\"Committing…\",errorDiffJson:\"PlanGenerationDiff must be valid JSON.\",errorDiffShape:\"PlanGenerationDiff must contain node_decisions, tasks, and edges arrays.\",errorVersion:\"Evolution rejected as a whole: the plan changed before commit. Refresh the plan, review the active generation, then retry with the new base version.\",errorInFlight:\"Evolution rejected as a whole: one or more touched nodes are already in flight. Keep committed work intact, wait for those nodes to settle or add follow-up nodes, then retry.\",errorDisconnected:\"Evolution rejected as a whole: every new root task must depend on prior execution, or be explicitly marked detached.\",errorIdempotency:\"Evolution rejected: this idempotency key was already used with different input. Reuse the original request or generate a new key.\",errorGeneric:\"Evolution rejected as a whole. Refresh the plan, review conflicts, and retry with a new idempotency key.\"},depError:{self:\"A task can't depend on itself.\",cycle:\"That would create a cycle in the plan.\",pending:\"Dependencies can only be edited while the plan is pending.\",generic:\"Couldn't update the plan's dependencies. Please try again.\"},resumeError:{agentBusy:\"Its agent is busy on another task — it'll resume this one when that finishes, or the agent can resume it from its side.\",nodeNotPaused:\"Nothing to resume — this node has no paused task (it may have already resumed).\",planNotRunning:\"The plan isn't running, so its nodes can't be resumed.\",generic:\"Couldn't resume this node. Please try again.\"},nodeStatus:{blocked:\"blocked\",ready:\"ready\",dispatched:\"dispatched\",running:\"running\",paused:\"paused\",done:\"done\",failed:\"failed\",supersededDraining:\"superseded / draining\"},taskList:{empty:\"No tasks in this plan yet.\",filterAria:\"Filter tasks\",filterPlaceholder:\"Filter by title, Task id, or assignee…\",showing:\"Showing {{shown}} of {{total}}\",noMatch:\"No tasks match your filter.\",colTask:\"Task\",colTitle:\"Title\",colAssignee:\"Assignee\",colTaskStatus:\"Task status\",colNodeStatus:\"Node status\",colCreated:\"Created\",colStarted:\"Started\",colEnded:\"Ended\",colDuration:\"Duration\",colAction:\"Action\",unassigned:\"Unassigned\",sea
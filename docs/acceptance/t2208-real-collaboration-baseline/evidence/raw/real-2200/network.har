\",evolution:\"Evolution\",edit:\"Edit\",start:\"Start\",archive:\"Archive\",delete:\"Delete\",archiveTitle:\"Archive this plan and all its tasks (terminal, cannot be undone)\",deleteTitle:\"Delete this plan (unloads its tasks to the Backlog, cannot be undone)\"},lifecycle:{pause:\"Pause\",resume:\"Resume\",start:\"Start\"},meta:{progress:\"Progress\",target:\"Target\",creator:\"Creator\"},rail:{nodesDone:\"nodes done\"},goal:{close:\"Close goal\",title:\"Plan goal\",heading:\"Goal\",empty:\"No goal set.\",showLess:\"Show less\",showMore:\"Show more\"},upNext:{title:\"Up next\",empty:\"No nodes queued.\",more:\"+{{count}} more — view DAG\"},deleteModal:{title:\"Delete this plan?\",body:\"This unloads all this plan's tasks back to the Backlog, permanently deletes the plan's conversation, and deletes the plan. This cannot be undone.\",confirm:\"Delete plan\",pending:\"Deleting…\"},archiveModal:{title:\"Archive this plan?\",body:\"This hides the terminal plan from active views while preserving its done/discarded lifecycle truth and execution history.\",confirm:\"Archive plan\",pending:\"Archiving…\"},discardModal:{title:\"Discard this plan?\",body:\"This permanently abandons the plan and discards its unfinished tasks. Completed tasks and stage history remain immutable.\",confirm:\"Discard plan\",pending:\"Discarding…\"},editModal:{aria:\"Edit plan\",title:\"Edit Plan\",name:\"Name\",goal:\"Goal\",targetDate:\"Target date\",save:\"Save changes\",saving:\"Saving…\",errorArchived:\"This plan is archived and can no longer be edited.\",errorPending:\"The target date can only be changed while the plan is pending.\",errorGeneric:\"Couldn't save your changes. Please try again.\"},evolutionModal:{aria:\"Plan evolution\",title:\"Commit plan evolution\",baseVersion:\"Base version {{version}}\",parentGeneration:\"Parent generation {{id}}\",liveStatus:\"{{status}} topology\",reason:\"Reason\",evidence:\"Evidence\",idempotency:\"Idempotency key\",diff:\"PlanGenerationDiff JSON\",dif
t:\"下一页\",reasonLabel:\"原因\",initialTitle:\"初始 DAG\",initialReason:\"计划启动时投影出的初始分阶段 DAG。\",addedOne:\"新增 {{stage}}\",addedMany:\"新增 {{count}} 个阶段：{{stages}}\",reasonFromVerdict:\"由 verdict {{verdict}} 触发新增。\",reasonFromContinuation:\"由 continuation {{continuation}} 触发新增。\",reasonUnknown:\"未记录本次迭代原因。\",stageTaskCount:\"{{stages}} 个阶段 · {{tasks}} 个任务\",generationProgress:\"完成 {{done}}/{{total}}\",diffLabel:\"Diff\",diffSummary:\"+{{nodes}} 个任务 · {{decisions}} 个节点决策 · +{{edges}} 条边\",diffEmpty:\"无拓扑变更\",active:\"活跃\",idempotency:\"幂等键 {{key}}\",generationId:\"generation {{id}}\",parentId:\"parent {{id}}\",verdict:\"verdict {{id}}\",verdictWithOutcome:\"{{outcome}} {{id}}\",continuation:\"continuation {{id}}\",stageRevisionTitle:\"{{revision}} 由后续 DAG evolution revision 新增\"}},actions:{menu:\"操作\",hideGoal:\"隐藏目标\",showGoal:\"显示目标\",pause:\"暂停\",discard:\"丢弃\",reopen:\"重开\",evolution:\"Evolution\",edit:\"编辑\",start:\"启动\",archive:\"归档\",delete:\"删除\",archiveTitle:\"归档此计划及其所有任务（终态，无法撤销）\",deleteTitle:\"删除此计划（将其任务卸载回待办池，无法撤销）\"},lifecycle:{pause:\"暂停\",resume:\"恢复\",start:\"启动\"},meta:{progress:\"进度\",target:\"目标日期\",creator:\"创建者\"},rail:{nodesDone:\"已完成节点\"},goal:{close:\"关闭目标\",title:\"计划目标\",heading:\"目标\",empty:\"未设置目标。\",showLess:\"收起\",showMore:\"展开\"},upNext:{title:\"接下来\",empty:\"没有排队的节点。\",more:\"还有 {{count}} 个 — 查看 DAG\"},deleteModal:{title:\"删除此计划？\",body:\"这将把此计划的所有任务卸载回待办池，永久删除此计划的对话，并删除此计划。此操作无法撤销。\",confirm:\"删除计划\",pending:\"删除中…\"},archiveModal:{title:\"归档此计划？\",body:\"这会把终态计划从活跃视图中隐藏，同时保留 done/discarded 生命周期事实和完整执行历史。\",confirm:\"归档计划\",pending:\"归档中…\"},discardModal:{title:\"丢弃此计划？\",body:\"这会永久放弃该计划，并丢弃其中尚未完成的任务；已完成任务与 Stage 历史保持不可变。\",confirm:\"丢弃计划\",pending:\"丢弃中…\"},editModal:{aria:\"编辑计划\",title:\"编辑计划\",name:\"名称\",goal:\"目标\",targetDate:\"目标日期\",save:\"保存更改\",saving:\"保存中…\",errorArchived:\"此计划已归档，无法再编辑。\",errorPending:\"目标日期只能在计划待执行时更改。\",errorGeneric:\"无法保存你的更改。请重试。\"},evolutionModal:{aria:\"计划 Evolution\",title:\"提交计划 Evolution\",baseVersion:\"基础版本 {{version}}\",parentGeneration:\"父 generation {{id}}\",liveStatus:\"{{status}} 拓扑\",reason:\"原因\",evidence:\"证据\",idempotency:\"幂等键\",diff:\"PlanGenerationDiff JSON\",diffHint:\"必须提供完整的 node_decisions、tasks、edges 数组；新增任务 ref 可用于 edge 的 from/to。\",commit:\"提交 Evolution\",committing:\"提交中…\",errorDiffJson:\"PlanGenerationDiff 必须是合法 JSON。\",errorDiffShape:\"PlanGenerationDiff 必须包含 node_decisions、tasks、edges 数组。\",errorVersion:\"Evolution 已被整体拒绝：提交前计划已变化。刷新计划，复核活跃 generation，然后用新的基础版本重试。\",errorInFlight:\"Evolution 已被整体拒绝：一个或多个被触及节点已在途。保留已提交工作，等待这些节点稳定或追加后续节点，然后重试。\",errorDisconnected:\"Evolution 已被整体拒绝：每个新增 root 任务都必须依赖已有执行路径，或显式标记为 detached。\",errorIdempotency:\"Evolution 已被拒绝：该幂等键已被不同输入使用。请复用原请求或生成新键。\",errorGeneric:\"Evolution 已被整体拒绝。刷新计划，复核冲突，并使用新的幂等键重试。\"},depError:{self:\"任务不能依赖自身。\",cycle:\"这会在计划中产生循环。\",pending:\"依赖只能在计划待执行时编辑。\",generic:\"无法更新计划的依赖。请重试。\"},resumeError:{agentBusy:\"其智能体正忙于另一任务——待该任务完成后会恢复此任务，或智能体可从其侧恢复。\",nodeNotPaused:\"无可恢复内容——此节点没有暂停的任务（可能已经恢复）。\",planNotRunning:\"计划未在运行，因此其节点无法被恢复。\",generic:\"无法恢复此节点。请重试。\"},nodeStatus:{blocked:\"受阻\",ready:\"就绪\",dispatched:\"已派发\",running:\"运行中\",paused:\"已暂停\",done:\"已完成\",failed:\"失败\",supersededDraining:\"已替代 / 收尾中\"},taskList:{empty:\"此计划尚无任务。\",filterAria:\"筛选任务\",filterPlaceholder:\"按标题、任务 ID 或负责人筛选…\",showing:\"显示 {{shown}} / {{total}}\",noMatch:\"没有任务匹配你的筛选。\",colTask:\"任务\",colTitle:\"标题\",colAssignee:\"负责人\",colTaskStatus:\"任务状态\",colNodeStatus:\"节点状态\",colCreated:\"创建时间\",colStarted:\"启动时间\",colEnded:\"结束时间\",colDuration:\"运行时长\",colAction:\"操作\",unassigned:\"未分配\",searchMembers:\"搜索成员…\",reassign:\"重新分配 {{title}}\",removeError:\"无法将此任务从计划中移除。请重试。\",assignError:\"无法重新分配此任务。请重试。\",resume:\"恢复\",resuming:\"恢复中…\",resumeAria:\"恢复 {{title}}\",resumeTitle:\"恢复此暂停的节点（唤醒其智能体）\",confirm:\"确认？\",removeAria:\"将 {{title}} 从计划中移除\",removeConfirmTitle:\"再次点击以确认移除\",removeTitle:\"从计划中移除（返回待办池）\"}},list:{title:\"计划\",searchLabel:\"搜索计划\",searchPlaceholder:\"搜索计划…\",statusLabel:\"状态\",projectLabel:\"项
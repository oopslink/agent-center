InFlight:\"Evolution 已被整体拒绝：一个或多个被触及节点已在途。保留已提交工作，等待这些节点稳定或追加后续节点，然后重试。\",errorDisconnected:\"Evolution 已被整体拒绝：每个新增 root 任务都必须依赖已有执行路径，或显式标记为 detached。\",errorIdempotency:\"Evolution 已被拒绝：该幂等键已被不同输入使用。请复用原请求或生成新键。\",errorGeneric:\"Evolution 已被整体拒绝。刷新计划，复核冲突，并使用新的幂等键重试。\"},depError:{self:\"任务不能依赖自身。\",cycle:\"这会在计划中产生循环。\",pending:\"依赖只能在计划待执行时编辑。\",generic:\"无法更新计划的依赖。请重试。\"},resumeError:{agentBusy:\"其智能体正忙于另一任务——待该任务完成后会恢复此任务，或智能体可从其侧恢复。\",nodeNotPaused:\"无可恢复内容——此节点没有暂停的任务（可能已经恢复）。\",planNotRunning:\"计划未在运行，因此其节点无法被恢复。\",generic:\"无法恢复此节点。请重试。\"},nodeStatus:{blocked:\"受阻\",ready:\"就绪\",dispatched:\"已派发\",running:\"运行中\",paused:\"已暂停\",done:\"已完成\",failed:\"失败\",supersededDraining:\"已替代 / 收尾中\"},taskList:{empty:\"此计划尚无任务。\",filterAria:\"筛选任务\",filterPlaceholder:\"按标题、任务 ID 或负责人筛选…\",showing:\"显示 {{shown}} / {{total}}\",noMatch:\"没有任务匹配你的筛选。\",colTask:\"任务\",colTitle:\"标题\",colAssignee:\"负责人\",colTaskStatus:\"任务状态\",colNodeStatus:\"节点状态\",colCreated:\"创建时间\",colStarted:\"启动时间\",colEnded:\"结束时间\",colDuration:\"运行时长\",colAction:\"操作\",unassigned:\"未分配\",searchMembers:\"搜索成员…\",reassign:\"重新分配 {{title}}\",removeError:\"无法将此任务从计划中移除。请重试。\",assignError:\"无法重新分配此任务。请重试。\",resume:\"恢复\",resuming:\"恢复中…\",resumeAria:\"恢复 {{title}}\",resumeTitle:\"恢复此暂停的节点（唤醒其智能体）\",confirm:\"确认？\",removeAria:\"将 {{title}} 从计划中移除\",removeConfirmTitle:\"再次点击以确认移除\",removeTitle:\"从计划中移除（返回待办池）\"}},list:{title:\"计划\",searchLabel:\"搜索计划\",searchPlaceholder:\"搜索计划…\",statusLabel:\"状态\",projectLabel:\"项目\",allProjects:\"全部项目\",clearFilters:\"清除筛选\",loading:\"正在加载计划…\",empty:\"暂无计划。\",emptyFiltered:\"没有匹配的计划。\",by:\"由 {{name}}\",col:{name:\"名称\",status:\"状态\",project:\"项目\",progress:\"进度\",created:\"创建时间\",creator:\"创建者\",updated:\"更新时间\"},summary:{heading:\"计划 · 摘要\",close:\"关闭\",closeAria:\"关闭摘要面板\",id:\"ID\",name:\"名称\",status:\"状态\",project:\"项目\",nodes:\"节点\",created:\"创建时间\",creator:\"创建者\",actions:\"操作\",openPlan:\"打开计划\"}},board:{rotateHint:\"↻ 旋转到横屏以获得更好的工作看板视图。\",rotateDismiss:\"忽略旋转提示\",
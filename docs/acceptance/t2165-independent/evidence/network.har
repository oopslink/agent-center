edit:\"编辑\",delete:\"删除\"},remote:{heading:\"远程 —\",liveBadge:\"实时 · 远程\",tabs:{commits:\"提交\",branches:\"分支\"},branchLabel:\"分支\",noCommits:\"暂无提交。\",noBranches:\"暂无分支。\",defaultBranch:\"默认\",footer:\"实时来自远程（go-github；回退到 git ls-remote）。从不克隆。\",unavailable:\"远程查看当前不可用。\"},commits:{dayHeader:\"{{day}} 的提交\",unknownDate:\"未知日期\"},commit:{hideDescriptionAria:\"隐藏提交描述\",showDescriptionAria:\"显示提交描述\",hideDescription:\"隐藏描述\",showDescription:\"显示描述\",unknownAuthor:\"未知\",committed:\"提交于 {{time}}\",browseAria:\"在 {{short}} 处浏览仓库\",browseTitle:\"在此处浏览仓库\",copyAria:\"复制完整的提交 SHA\",copied:\"已复制\",copyTitle:\"复制完整 SHA\"},form:{editTitle:\"编辑代码仓库\",addTitle:\"添加代码仓库\",close:\"关闭\",label:\"名称\",labelPlaceholder:\"agent-center\",provider:\"提供方\",providerGithub:\"GitHub\",providerGit:\"Git（通用）\",description:\"描述\",descriptionHint:\"用一行描述，让代理无需检出即可理解该仓库。\",descriptionPlaceholder:\"此仓库的用途\",url:\"克隆 URL\",urlPlaceholder:\"git@github.com:org/repo.git\",defaultBranch:\"默认分支\",defaultBranchPlaceholder:\"main\",credential:\"读取凭据\",credentialHintEdit:\"留空以保留已存储的凭据。\",credentialHintCreate:\"加密存储，不再显示。\",credentialPlaceholderStored:\"•••••• (已存储)\",credentialPlaceholder:\"细粒度令牌\",credentialHelp:\"私有仓库需要只读凭据。对于 GitHub，请创建一个<tokenLink>细粒度令牌</tokenLink>，将其范围限定到此仓库，并设置 <contents>Contents: Read-only</contents>（添加 <prs>Pull requests: Read</prs> 以查看 PR）。GitHub App 安装令牌或只读部署密钥同样适用。公开仓库可以将此项留空。\",cancel:\"取消\",saving:\"保存中…\",save:\"保存\"}},AC={title:\"模型类目\",subtitle:\"组织级、用户自管的可用模型集合——你的 agent 可运行这些模型。无内置条目,全部由你管理。\",add:\"+ 添加模型\",edit:\"编辑\",delete:\"删除\",cancel:\"取消\",save:\"保存\",empty:\"暂无模型\",emptyDesc:\"在下方添加一个模型或导入 JSON 类目。\",addTitle:\"添加模型\",editTitle:\"编辑模型\",deleteTitle:\"删除模型\",deleteConfirm:\"从类目中删除模型「{{name}}」?\",col:{modelId:\"模型 ID\",displayName:\"显示名\",inputCost:\"输入 $/MTok\",outputCost:\"输出 $/MTok\",contextWindow:\"上下文\",tier:\"档位/描述\"},import:{button:\"批量导入 (JSON)\",title:\"批量导入 (JSON)\",help:\"粘贴条目的 JSON 数组。upsert 按 model_id 合并;replace 替换整个类目。任何非法条目(schema 错、model_id 重复、负成本)都会整批拒绝。\",upsert:\"增量合并\",replace:\"整体替换\",run:\"导入\",close:\"关闭\",parseError:\"JSON 解析失败:{{detail}}\",notArray:\"JSON 非法:需要一个条目数组。\",failed:\"导入失败——{{count}} 条中 0 条生效。\",result:\"已导入 {{imported}} 条(失败 {{failed}} 条)。\",ok:\"已导入 {{count}} 条。\"}},EC={title:\"密钥\",new:\"新建密钥\",revoke:\"吊销\",disclaimer:\"密钥值以加密形式存储，创建后将不再显示。如需轮换密钥，请吊销后再创建新密钥。\",empty:{title:\"暂无密钥\",body:\"密钥用于存储智能体在运行时引用的 API 密钥和令牌。密钥值在静态存储时加密，创建后将不再显示。\"},column:{name:\"名称\",kind:\"类型\",state:\"状态\",created:\"创建时间\"},confirm:{title:\"吊销密钥？\",message:\"确定要吊销密钥“{{name}}”吗？此操作无法撤销。\"},modal:{title:\"新建密钥\",name:\"名称\",namePlaceholder:\"github-token\",kind:\"类型\",value:\"密钥值\",valuePlaceholder:\"粘贴密钥\",valueHelp:\"以加密形式存储，且不会再次显示——如需轮换，请吊销此密钥并创建新密钥。\",cancel:\"取消\",create:\"创建\",creating:\"创建中…\",done:\"完成\"},success:{before:\"密钥 \",after:\" 已创建。\"}},RC={title:\"AI Runtime\",subtitle:\"组织级 Runtime Model 与 Runtime CLI 目录，供智能体运行时配置使用。\",actions:{exportYaml:\"导出 YAML\",newModel:\"新建 Model\",newCLI:\"新建 CLI\",importModels:\"导入 YAML/JSON\",edit:\"编辑\",disable:\"停用\",enable:\"启用\",delete:\"删除\",disableSelected:\"批量停用\",enableSelected:\"批量启用\",deleteSelected:\"批量删除\"},permissions:{unknownRole:\"成员\",manage:\"组织成员均可看到此页。你的 {{role}} 角色可以管理运行时目录条目。\",readOnly:\"组织成员均可看到此页。你的 {{role}} 角色为只读；owner 和 admin 可管理运行时目录条目。\"},summary:{revision:\"修订\"},common:{actions:\"操作\"},bulk:{selectedCount:\"已选择 {{count}} 项\",selectAllModels:\"选择全部 Runtime Model\",selectModel:\"选择 Runtime Model {{name}}\",selectAllCLIs:\"选择全部 Runtime CLI\",selectCLI:\"选择 Runtime CLI {{name}}\"},tabs:{aria:\"AI Runtime 目录分区\",models:\"Models\",clis:\"CLIs\"},empty:{models:\"暂无 Runtime Model\",modelsBody:\"Runtime Model 定义各 CLI 可运行的模型 key。\",clis:\"暂无 Runtime CLI\",clisBody:\"Runtime CLI 定义 Worker 必须提供的可执行程序。\"},model:{name:\"Model\",modelKey:\"模型 key\",compatibleCli:\"兼容 CLI\",context:\"上下文\",cost:\"输入 / 输出 $/MTok\",status:\"状态\"},cli:{name:\"CLI\",executable:\"可执行程序\",version:\"版本\",features:\"特性\",status:\"状态\",system:\"系统\"},status:{enabled:\"启用\",disabled:\"停用\"},disableConfirm:{modelTitle:\"停用 Runtime Model？\",modelMessage:\"确定要停用“{{name}}”吗？已有保存引用仍可见，但新的运行时选择不会再提供该模型。\",modelsTitle:\"停用选中的 Runtime Models？\",modelsMessage:\"确定要停用选中的 {{count}} 个 Runtime Models 吗？已有保存引用仍可见，但新的运行时选择不会再提供这些模型。\",cliTitle:\"停用 Runtime CLI？\",cliMessage:\"确定要停用“{{name}}”吗？已有保存引用仍可见，但 worker 和新的运行时选择不会再提供该 CLI。\",clisTitle:\"停用选中的 Runtime CLIs？\",clisMessage:\"确定要停用选中的 {{count}} 个 Runtime CLIs 吗？已有保存引用仍可见，但 worker 和新的运行时选择不会再提供这些 CLI。\"},deleteConfirm:{modelTitle:\"删除 Runtime Model？\",modelMessage:\"确定要删除“{{name}}”吗？这会从 AI Runtime 目录中移除该模型。\",modelsTitle:\"删除选中的 Runtime Models？\",modelsMessage:\"确定要删除选中的 {{count}} 个 Runtime Models 吗？这会从 AI Runtime 目录中移除它们。\",cliTitle:\"删除 Runtime CLI？\",cliMessage:\"确定要删除“{{name}}”吗？这会从 AI Runtime 目录中移除该 CLI。引用它的 Model 会保留 key，但匹配 CLI 再次存在前不会成为可选组合。\",clisTitle:\"删除选中的 Runtime CLIs？\",clisMessage:\"确定要删除选中的 {{count}} 个 Runtime CLIs 吗？引用它们的 Model 会保留 key，但匹配 CLI 再次存在前不会成为可选组合。\"},form:{newModel:\"新建 Model\",editModel:\"编辑 Model\",newCLI:\"新建 CLI\",editCLI:\"编辑 CLI\",key:\"稳定 key\",defaultParameters:\"Default parameters JSON\",parameterSchema:\"Parameter schema JSON\",enabled:\"启用\",inputCost:\"输入 $/MTok\",outputCost:\"输出 $/MTok\",tier:\"Tier\",immutableKey:\"稳定 key 创建后不可变；后端会拒绝 key 变更。\",systemHint:\"这是系统 CLI。后端会保留它的系统标记和不可变 key；这里只提交表单中展示的可编辑字段。\",cancel:\"取消\",save:\"保存\",saving:\"保存中...\"},import:{title:\"导入 AI Runtime\",help:\"粘贴导出的 AI Runtime YAML/JSON 文档。旧的模型定义 JSON 数组仍然支持，并会在预览前转换为完整 runtime 文档。\",scope:\"导出文档会直接导入 CLIs 和 Models。旧模型数组会在生成文档中保留现有 CLIs（{{clis}}）。\",preview:\"预览\",previewing:\"预览中...\",apply:\"应用导入\",applying:\"应用中...\",revision:\"修订 {{revision}}\",preserved:\"已保留 {{clis}} 个 CLIs\",noModelChanges:\"此次导入没有 Model 变更。\",entity:\"实体\",key:\"Key\",action:\"动作\",diagnostics:\"诊断\",applied:\"已应用。新修订：{{revision}}\"}},_C={title:\"唤醒护栏\",description:\"防止智能体之间失控的连环唤醒（链路深度 / 循环 / 速率限制 / Token 预算）。保存后立即生效——无需重启。\",loading:\"正在加载护栏参数…\",error:{load:\"加载护栏设置失败。\",retry:\"重试\"},fields:{max_depth:{label:\"最大唤醒链深度\",hint:\"单条唤醒链中的最大跳数；超过即触发熔断 · 默认 {{def}}\"},cycle_window_sec:{label:\"循环检测窗口（秒）\",hint:\"在此滚动窗口内统计往返次数 · 默认 {{def}}\"},cycle_threshold:{label:\"循环阈值（每窗口往返次数）\",hint:\"在窗口内达到此往返次数即触发熔断 · 默认 {{def}}\"},rate_per_min:{label:\"速率限制（每分钟智能体唤醒数）\",hint:\"单个智能体每分钟由智能体驱动唤醒的 Token 数 · 默认 {{def}}\"},chain_token_budget:{label:\"链路 Token 预算（根）\",hint:\"每条唤醒链的成本预算，每跳递减 · 默认 {{def}}\"}},invalid:\"所有阈值必须为正整数（> 0）。\",saveError:\"保存失败：{{message}}\",unknownError:\"未知错误\",saving:\"正在保存…\",save:\"保存\",saved:\"已保存并生效\"},LC={environment:kC,systemNav:TC,orgSettings:jC,repos:CC,modelCatalog:AC,secrets:EC,aiRuntime:RC,wakeGuardrail:_C},DC={enum:{unknown:\"未知值\"},drilldownValue:{source:{backend:\"后端\"}},breadcrumb:\"面包屑\",overview:{title:\"Insight 概览\",byAgent:\"按智能体查看\",byProject:\"按项目查看\",tableSubtitle:\"按已结束执行次数降序；同数时按 ID 排序；最多显示 20 项。\"},nav:{section:\"洞察\",overview:\"概览\",agents:\"智能体\",projects:\"项目\",executions:\"Task executions\",collaboration:\"协作作用力\"},collaboration:{title:\"协作作用力\",subtitle:\"组织级 Agent → Plan → Stage → Task 关系与确定性作用图。\",scopeRequired:\"请选择项目\",scopeRequiredBody:\"加载项目图后，可按 Plan、Task、Agent、关系或时间逐步缩小范围。\",loading:\"正在加载协作作用力\",failed:\"协作作用力加载失败\",forbidden:\"你没有查看协作证据的权限\",empty:\"没有协作作用\",emptyBody:\"没有确定性作用符合当前筛选。\",truncated:\"当前显示前 {{count}} 条边，请缩小筛选范围查看其余结果。\",loadMore:\"加载更多\",loadingMore:\"正在加载更多…\",summary:\"作用摘要\",affectedTasks:\"受影响任务\",graph:\"协作作用力图\",edgeList:\"可键盘操作的图边\",timeline:\"作用时间线\",magnitude:\"强度 {{value}}\",aggregatedEffects:\"{{count}} 个作用\",filters:{label:\"筛选/定位\",clearAll:\"清除筛选\",project:\"项目\",plan:\"Plan\",task:\"任务\",agent:\"Agent\",since:\"开始时间\",until:\"结束时间\",relation:\"关系\",polarity:\"极性\",all:\"全部\",chooseProject:\"选择项目\",chooseTask:\"任意任务\",chooseProjectFirst:\"先选择项目\",anyPlan:\"任意 Plan\",anyAgent:\"任意 Agent\",loadingProjects:\"正在加载项目\",loadingTasks:\"正在加载任务\",searchProjects:\"搜索项目\",searchPlans:\"搜索 Plan\",searchTasks:\"搜索任务\",searchAgents:\"搜索 Agent\",noProjects:\"没有项目\",noPlans:\"没有 Plan\",noTasks:\"没有任务\",no
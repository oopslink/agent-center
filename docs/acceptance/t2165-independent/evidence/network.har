\"},common:{actions:\"Actions\"},bulk:{selectedCount:\"{{count}} selected\",selectAllModels:\"Select all runtime models\",selectModel:\"Select runtime model {{name}}\",selectAllCLIs:\"Select all runtime CLIs\",selectCLI:\"Select runtime CLI {{name}}\"},tabs:{aria:\"AI Runtime catalog sections\",models:\"Models\",clis:\"CLIs\"},empty:{models:\"No runtime models\",modelsBody:\"Runtime models define the model keys each CLI can run.\",clis:\"No runtime CLIs\",clisBody:\"Runtime CLIs define the executables workers must provide.\"},model:{name:\"Model\",modelKey:\"Model key\",compatibleCli:\"Compatible CLIs\",context:\"Context\",cost:\"Input / output $/MTok\",status:\"Status\"},cli:{name:\"CLI\",executable:\"Executable\",version:\"Version\",features:\"Features\",status:\"Status\",system:\"System\"},status:{enabled:\"Enabled\",disabled:\"Disabled\"},disableConfirm:{modelTitle:\"Disable runtime model?\",modelMessage:'Disable \"{{name}}\"? Existing saved references stay visible, but new runtime selection will not offer this model.',modelsTitle:\"Disable selected runtime models?\",modelsMessage:\"Disable {{count}} selected runtime models? Existing saved references stay visible, but new runtime selection will not offer these models.\",cliTitle:\"Disable runtime CLI?\",cliMessage:'Disable \"{{name}}\"? Existing saved references stay visible, but workers and new runtime selection will not offer this CLI.',clisTitle:\"Disable selected runtime CLIs?\",clisMessage:\"Disable {{count}} selected runtime CLIs? Existing saved references stay visible, but workers and new runtime selection will not offer these CLIs.\"},deleteConfirm:{modelTitle:\"Delete runtime model?\",modelMessage:'Delete \"{{name}}\"? This removes the model from the AI Runtime catalog.',modelsTitle:\"Delete selected runtime models?\",modelsMessage:\"Delete {{count}} selected runtime models? This removes them from the AI Runtime catalog.\",cliTitle:\"Delete runtime CLI?\",cliMessage:'Delete \"{{name}}\"? This removes th
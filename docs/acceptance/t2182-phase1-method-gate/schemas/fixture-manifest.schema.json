{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-center.local/schemas/t2182-phase1/fixture-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "created_at",
    "source",
    "agent_A",
    "agent_B",
    "task",
    "event_queries",
    "effect_queries"
  ],
  "properties": {
    "created_at": { "type": "string" },
    "source": { "const": "agent-center-official-mcp-api-create-response" },
    "agent_A": { "$ref": "#/$defs/agent" },
    "agent_B": { "$ref": "#/$defs/agent" },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "initial_owner", "reassigned_by", "final_owner"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "initial_owner": { "type": "string", "minLength": 1 },
        "reassigned_by": { "type": "string", "minLength": 1 },
        "final_owner": { "type": "string", "minLength": 1 }
      }
    },
    "event_queries": { "type": "array", "items": { "type": "object" } },
    "effect_queries": { "type": "array", "items": { "type": "object" } }
  },
  "$defs": {
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }
      }
    }
  }
}
